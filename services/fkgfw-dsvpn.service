# Managed by fkgfw (DSVPN)
[Unit]
Description=fkgfw DSVPN server
Wants=network-online.target fkgfw-dsvpn-download.service fkgfw-dsvpn-tunnel.service
After=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/fkgfw-dsvpn/server.env
RuntimeDirectory=fkgfw-dsvpn
RuntimeDirectoryMode=0700
# Synchronize the local checkout before launching the root-owned executable.
ExecStartPre=+/bin/bash /etc/fkgfw-dsvpn/select-release activate
# The release link is created by ExecStartPre. ExecStart needs the resulting executable.
BindReadOnlyPaths=-/run/fkgfw-dsvpn/release/clients/@ARCH@/dsvpn:/run/fkgfw-dsvpn/dsvpn
ExecStart=/usr/bin/env /run/fkgfw-dsvpn/dsvpn server /etc/fkgfw-dsvpn/vpn.key :: ${VPN_PORT}
Restart=on-failure
RestartSec=3
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=true
ProtectKernelTunables=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_NETLINK AF_INET AF_INET6 AF_UNIX AF_PACKET

[Install]
WantedBy=multi-user.target
