# Managed by fkgfw (DSVPN)
[Unit]
Description=fkgfw DSVPN client downloads
After=network.target

[Service]
Type=exec
DynamicUser=yes
EnvironmentFile=/etc/fkgfw-dsvpn/server.env
ExecStart=/opt/fkgfw-dsvpn/darkhttpd /opt/fkgfw-dsvpn/public --ipv6 --port ${DOWNLOAD_PORT} --no-listing --no-server-id --maxconn 64
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=/etc/fkgfw-dsvpn
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
